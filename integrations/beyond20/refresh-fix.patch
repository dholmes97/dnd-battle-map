+function ensureCustomTab(tab) {
+    const pending = customTabChecks.get(tab.id);
+    if (pending) {
+        pending.tab = tab;
+        pending.again = true;
+        return;
+    }
+    const check = { tab, again: false };
+    customTabChecks.set(tab.id, check);
+    const finish = () => {
+        if (customTabChecks.get(tab.id) !== check) return;
+        customTabChecks.delete(tab.id);
+        if (check.again) ensureCustomTab(check.tab);
+    };
+    // A tab ID survives navigation; its content script does not. Probe the
+    // current document instead of treating the old registration as liveness.
+    chrome.tabs.sendMessage(tab.id, { action: "beyond20-custom-site-ping" }, response => {
+        const missing = chrome.runtime.lastError || !response || response.beyond20 !== true;
+        if (customTabChecks.get(tab.id) !== check) return;
+        if (!missing) {
+            addCustomTab(tab);
+            finish();
+            return;
+        }
+        removeCustomTab(tab.id);
+        injectGenericSiteScripts([tab], () => {
+            // Reading lastError consumes failures when the tab navigated or
+            // closed during injection; the next completed load can retry.
+            if (chrome.runtime.lastError) console.warn("Beyond20 custom-site injection:", chrome.runtime.lastError.message);
+            finish();
+        });
