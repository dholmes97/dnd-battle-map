{
  "name": "dnd-battle-map-poc",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "npm run typecheck && npm run build && node --test tests/*.test.mjs && npm run test:components",
    "test:components": "vitest run",
    "test:live": "node --test tests/live/*.test.mjs",
    "backup:production": "node scripts/backup-production.mjs",
    "backup:verify": "node scripts/verify-production-backup.mjs",
    "db:bootstrap": "node scripts/bootstrap-local-database.mjs",
    "catalog:expand": "node scripts/build-creature-expansion.mjs",
    "catalog:batch-expansion": "node scripts/create-creature-expansion-batches.mjs",
    "scenario:provision": "node scripts/provision-scenario.mjs",
    "scenario:prepare-handout": "node scripts/prepare-scenario-handout.mjs",
    "scenario:prepare-creature": "node scripts/prepare-creature-art.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:generate-bootstrap": "node scripts/generate-bootstrap-migration.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "^30.0.1",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "^0.34.5",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "^4.1.10",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
